# ==========================================
# PDH-PKG - 环境变量模板
# 复制此文件为 .env 并填入实际值
# ==========================================

# --- DeepSeek ---
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# --- Embedding ---
# 默认与现有 2560 维向量索引保持一致，使用 Ollama qwen3-embedding:4b。
# 如需离线本地模型（BAAI/bge-small-zh-v1.5，512 维），请在设置页切换 provider，并重建知识库索引。
EMBEDDING_MODEL=qwen3-embedding:4b
EMBEDDING_BASE_URL=http://localhost:11434/v1
# EMBEDDING_DIM=2560  # 兼容旧配置，实际维度会自动探测

# --- Qdrant ---
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_COLLECTION=pdh_pkg

# --- Redis (异步任务保留) ---
REDIS_URL=redis://localhost:6379/0

# --- 服务配置 ---
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8001
LOG_LEVEL=INFO

# --- 认证（生产环境必须修改）---
PRESET_USERS=admin:change-me-admin:admin,user:change-me-user:admin
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=480

# --- OCR ---
TESSERACT_CMD=tesseract
OCR_LANG=chi_sim+eng

# --- 数据目录 ---
DATA_DIR=./data

# --- Neo4j 知识图谱（可选）---
# 指定 Neo4j 启动脚本与 Java 21 路径（留空则不自动拉起）
# NEO4J_BIN=C:/path/to/neo4j/bin/neo4j.bat
# NEO4J_JAVA_HOME=C:/Program Files/Java/jdk-21
NEO4J_PASSWORD=your-neo4j-password
